---
import PixelIcon from './PixelIcon.astro';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <PixelIcon name="star" size={22} />
      <span>Bistro's Tavern</span>
    </div>
    <p>© 2026 Bistro · 用 Astro 手工搭的小酒馆 · 灯一直留着</p>
    <a class="footer-top" href="#home">回到门口 ↑</a>
  </div>
  <p class="footer-easter">// 看到这里的冒险者，愿你的下一个点子真的跑起来。</p>
</footer>

<a class="back-to-top" id="back-to-top" href="#home" aria-label="返回顶部">↑</a>
