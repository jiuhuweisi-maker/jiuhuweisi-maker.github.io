---
import PixelIcon from './PixelIcon.astro';
import { ACTORS } from '../data/tavern';
---

<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true">
    <span class="hero__moon"><PixelIcon name="moon" size={62} /></span>
    <span class="hero__star" style="--x:12%;--y:18%;--d:.4s"></span>
    <span class="hero__star" style="--x:27%;--y:9%;--d:1.6s"></span>
    <span class="hero__star" style="--x:63%;--y:14%;--d:2.4s"></span>
    <span class="hero__star" style="--x:81%;--y:7%;--d:.9s"></span>
    <span class="hero__star" style="--x:92%;--y:26%;--d:1.9s"></span>
  </div>

  <div class="container hero__inner">
    <div class="hero__intro" data-reveal>
      <p class="eyebrow"><PixelIcon name="star" size={14} /> 互联网角落 · 今晚也营业 <PixelIcon name="star" size={14} /></p>

      <div class="sign" id="tavern-sign" title="……招牌好像可以敲一敲">
        <span class="sign__chain sign__chain--l" aria-hidden="true"></span>
        <span class="sign__chain sign__chain--r" aria-hidden="true"></span>
        <div class="sign__board">
          <span class="sign__tiny">✦ WELCOME TO ✦</span>
          <h1 class="sign__title" id="hero-title">Bistro's<br /><span>Tavern</span></h1>
          <span class="sign__tiny sign__tiny--bottom">酒 馆 · EST. 2026</span>
        </div>
      </div>

      <p class="hero__lead">
        欢迎来到我的小酒馆。<br />
        这里收留一些 AI 实验、代码、游戏，以及突然冒出来的奇怪想法。
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#quests">进入项目区 <span class="btn__arrow" aria-hidden="true">▶</span></a>
        <a class="btn btn--ghost" href="#about">关于店主</a>
      </div>
      <p class="hero__hint">↓ 往下走，委托板上钉着正在折腾的东西</p>
    </div>

    <div class="hero__scene" data-reveal>
      <span class="lantern lantern--left" aria-hidden="true"><i></i></span>
      <span class="lantern lantern--right" aria-hidden="true"><i></i></span>
      <div class="scene-frame" data-scene>
        <div class="scene-frame__art">
          <picture>
            <source media="(max-width: 720px)" srcset="/images/tavern-hero-sm.webp" />
            <img
              src="/images/tavern-hero.webp"
              width="1600"
              height="901"
              alt="像素风酒馆夜景：发光的 Bistro's Tavern 木招牌、暖色吊灯与木质吧台，龙娘与蓝发 AI 少女坐在吧台边，桌上有酒杯、笔记本电脑、甜点和睡着的小猫"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>

        <!-- 轻量动态图层：纯 CSS 光效 + JS 生成的星点，不加载视频 -->
        <div class="scene-fx" aria-hidden="true">
          <span class="scene-fx__moon"></span>
          <span class="scene-fx__lamp" style="--lx:8%;--ly:9%;--ld:0s"></span>
          <span class="scene-fx__lamp" style="--lx:23%;--ly:11%;--ld:1.3s"></span>
          <span class="scene-fx__lamp" style="--lx:39%;--ly:6%;--ld:2.6s;--lw:9%;--lh:16%"></span>
          <span class="scene-fx__lamp" style="--lx:7%;--ly:70%;--ld:.8s;--lw:13%;--lh:20%"></span>
          <span class="scene-fx__lamp" style="--lx:52%;--ly:83%;--ld:2.1s;--lw:11%;--lh:18%"></span>
          <span class="scene-fx__lamp" style="--lx:97%;--ly:70%;--ld:3.2s;--lw:12%;--lh:20%"></span>
          <div class="scene-fx__stars" data-scene-stars></div>
          <div class="scene-fx__zzz"><span>z</span><span>z</span><span>z</span></div>
          <span class="scene-fx__counter"></span>
        </div>

        <!-- 环境光点单独一层，按可见画布分布，手机裁切后不会错位 -->
        <div class="scene-motes" data-scene-motes aria-hidden="true"></div>

        <!-- 三角色点击热区：坐标由 layoutZones() 按 object-fit 实际绘制矩形换算 -->
        <div class="actor-zones" data-actor-zones>
          {ACTORS.map((actor) => (
            <button
              class="actor-zone"
              type="button"
              data-actor-zone={actor.id}
              aria-label={`点击和${actor.name}说话`}
              title={`点击和${actor.name}说话`}
            >
              <span class="actor-zone__tag">{actor.name}<span aria-hidden="true"> ▸</span></span>
            </button>
          ))}
        </div>

        <span class="scene-frame__glare" aria-hidden="true"></span>
        <button class="scene-cat" id="secret-cat" type="button" aria-label="摸摸吧台上的猫">
          <PixelIcon name="cat" size={22} />
        </button>
      </div>
      <p class="scene-caption">
        <span class="scene-caption__tag">NOW OPEN</span> 今晚也营业中，请随意找个位置坐下。
        <span class="scene-caption__hint">点击画里的伙伴聊天 · 左下角 ♪ 可放音乐。</span>
      </p>
    </div>
  </div>

  <div class="hero__bar" aria-hidden="true">
    <span>✦ 今日推荐：热可可 / 新点子</span>
    <span>✦ 店主：Bistro</span>
    <span>✦ 委托板已更新 9 份</span>
  </div>
</section>
