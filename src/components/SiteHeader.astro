---
import PixelIcon from './PixelIcon.astro';
import { navItems, site } from '../data/site';
---

<header class="site-header" id="site-header">
  <div class="header-inner container">
    <a class="brand" href="#home" aria-label={`${site.name} 回到首页`}>
      <span class="brand__icon"><PixelIcon name="star" size={26} /></span>
      <span class="brand__text">Bistro's <b>Tavern</b></span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class="nav__link" href={item.href}>
          <span class="nav__en">{item.en}</span>
          <span class="nav__cn">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-side">
      <span class="open-sign"><i aria-hidden="true"></i> OPEN</span>
      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="打开导航菜单"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
</header>
